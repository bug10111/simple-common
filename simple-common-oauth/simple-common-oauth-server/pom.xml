<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.simple.common</groupId>
        <artifactId>simple-common-oauth</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>simple-common-oauth-server</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-sms</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-eventbus</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-mp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-logs-server</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-auth-server</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-annex</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot-maven-plugin.versinon}</version>
                <configuration>
                    <!--表示打包后是可执行文件-->
                    <executable>true</executable>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <!--把依赖都打进jar-->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
