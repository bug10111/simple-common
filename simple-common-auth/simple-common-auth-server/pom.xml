<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.simple.common</groupId>
        <artifactId>simple-common-auth</artifactId>
        <version>1.0.2</version>
    </parent>

    <artifactId>simple-common-auth-server</artifactId>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-eventbus</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-auth-client</artifactId>
        </dependency>

        <!-- 服务端直接注入 StringRedisTemplate（spring-data-redis），显式声明依赖避免依赖传递链脆弱 -->
        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-redis</artifactId>
        </dependency>

        <!-- 服务端控制器与登录管理器（org.springframework.web.bind.annotation.*/WebApplicationContext/
             HttpStatus/HttpServletRequest）编译期需要 web 栈；与 simple-common-core 同口径 provided
             （由宿主 web 环境提供，不传递给消费方） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>
</project>