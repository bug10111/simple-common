<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.simple.common</groupId>
        <artifactId>simple-common-auth</artifactId>
        <version>1.0.2</version>
    </parent>

    <artifactId>simple-common-auth-client</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <!-- JJWT API：编译期直接依赖（此前经 jjwt-impl 传递引入，属脆弱形态） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <!-- JJWT 运行期提供者：经 ServiceLoader 装载，仅需 runtime -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-eventbus</artifactId>
        </dependency>

        <dependency>
            <groupId>com.simple.common</groupId>
            <artifactId>simple-common-cache</artifactId>
        </dependency>

        <!-- 客户端鉴权含 MVC 配置/拦截器/CSRF 控制器（WebMvcConfigurer/HandlerInterceptor/HttpServletRequest/
             org.springframework.web.bind.annotation.*），编译期需要 web 栈；
             与 simple-common-core 同口径 provided（由宿主 web 环境提供，不传递给消费方） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>